	width=&#34;1919&#34;
	height=&#34;1080&#34;
	srcset=&#34;https://DespairJasper.github.io/p/a-fantastic-journey-to-altay/scenery31_hu_985aad179f1b8d40.jpg 480w, https://DespairJasper.github.io/p/a-fantastic-journey-to-altay/scenery31_hu_e02763971f67258a.jpg 1024w&#34;
	loading=&#34;lazy&#34;
	
