	width=&#34;1919&#34;
	height=&#34;1080&#34;
	srcset=&#34;https://DespairJasper.github.io/p/a-fantastic-journey-to-altay/scenery21_hu_64198afc0a559e78.jpg 480w, https://DespairJasper.github.io/p/a-fantastic-journey-to-altay/scenery21_hu_9105eb7543558a44.jpg 1024w&#34;
	loading=&#34;lazy&#34;
	
