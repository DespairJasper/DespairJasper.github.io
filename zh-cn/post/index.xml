	loading=&#34;lazy&#34;
	
		alt=&#34;三湾背后的雪山&#34;
	
	
		class=&#34;gallery-image&#34; 
		data-flex-grow=&#34;56&#34;
		data-flex-basis=&#34;135px&#34;
	
&gt;&lt;/p&gt;
&lt;p&gt;&lt;img src=&#34;https://DespairJasper.github.io/p/a-fantastic-journey-to-altay/scenery33.jpg&#34;
