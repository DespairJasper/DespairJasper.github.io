width="1084"
height="1752"
srcset="https://www.despairjasper.com/p/a-fantastic-journey-to-altay/scenery7_hu_1f1351fa5b06c65b.jpg 480w, https://www.despairjasper.com/p/a-fantastic-journey-to-altay/scenery7_hu_7698e39b0a824837.jpg 1024w"
loading="lazy"
alt="唯一的一张合照，还是回到学校顺风车司机拍的"
class="gallery-image"
data-flex-grow="61"
